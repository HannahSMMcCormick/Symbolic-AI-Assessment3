domain avatar {

    requirements {multivalued, intermediate-nodes, partially-observed,reward_deterministic };


    types = {

            element: object
            location: object
            character: object
            character-type: object
            nation: object
            level: object
            avatar-state: object
            
            };
    
    
    
    };
    pvariables {
    
        connected(location, location): {non-fluent,bool}
        whereabouts(character): {state-fluent, location}
        bending_status(character, element): {non-fluent, level}
        elemental_affinity(character, element): {non-fluent, bool}
        avatar_state(character): {state-fluent, avatar-state}
        nation_affiliation(character, nation): {non-fluent, bool}
        character_type(character): {state-fluent, character-type}
        level(character): {state-fluent, level}
        person_location(character, location): {state-fluent, bool}
        move_to(location): {action-fluent, bool}
    
    };
    cpfs {
    
    // modelling moving from location to location

        person_location'(v) = 
        
        if (move_to(v) ^ exists_{u:location}[person_location(u) clock_and connected(u, v)]) then
        
            true
        else if (person_location(v) clock_an_not exists_{target:location}[move_to(target)]) then
        
            true
        
        else
        
            false)
        
        
        
        
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    };
    reward = {};
    state-invariants {};
    action-preconditions {};
    termination {};

}



fire, water, earth, air: element
            air-nomads, water-tribes, earth-kingdoms, fire-nations: nation
            northern-water-tribe, southern-water-tribe, northern-air-temple, southern-air-temple, eastern-air-temple, western-air-temple, ba-sing-se, omashu, kyoshi-island, fire-nation-capital, fire-nantion-colonies, republic-city: location
            current-avatar, civilian, villain, mentor, team-member: character
            avatar,bender,non-bender: character-type
            unknown, non-bender, training, mastered: level
            notknown, found, training, mastered, fully-realized: avatar-state
            #probs  more